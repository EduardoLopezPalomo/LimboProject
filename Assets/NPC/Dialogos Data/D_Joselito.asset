  NpcName: Joselito
  dayGreeting: "I don\u2019t like talking to priests. They\u2019re always going on
    and on about the gods, blah, blah, blah."
  dayFarewell: "Although if you want to know more about that, there\u2019s no one
    better to ask."
  nightText: 
  partyText: "Autumn\u2019s pastries are delicious! *Nom, gromph, glup, glup.*"
