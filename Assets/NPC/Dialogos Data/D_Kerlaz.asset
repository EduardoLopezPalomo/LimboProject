  m_Script: {fileID: 11500000, guid: 5fdbf8c1d48214749a486d70548f42cd, type: 3}
  m_Name: D_Kerlaz
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  NpcName: Kerlaz
  tipoVoz: 2
  retrato: {fileID: 21300000, guid: 64309034b12384448aefbf792f48ea8e, type: 3}
  dayGreeting:
  - "You\u2019ll be surprised, but the days when the human village has a festival
    are the days when we have the fewest problems."
  - "That\u2019s why we take the opportunity to restock, relax, and throw our own
    little party. Even though we don\u2019t believe in the gods."
  nightText: "Good evening. If you have trouble sleeping, a cup of tea and a book
    work wonders. Well, that\u2019s what they say. I can\u2019t read."
  partyText: 
  NpcId: Kerlazbdba781d-a179-4097-8f58-e5a05c981412
  ActualQuest: {fileID: 11400000, guid: c8a21fe29815866478f8fcd871ce966e, type: 2}
  ActualGoal: {fileID: 11400000, guid: 322cb428272b71f488666e82291a81fb, type: 2}
  GiveSecondaryQuest: {fileID: 0}
  QuestDialogue:
  - You're looking for Naius' Totem? It's dangerous to go alone, are you sure?
  - The party starts very soon, you can talk to the gods there if that's what you
    need... Although I don't know if Naius will go this time...
  - 'Well, as you wish. You have to follow the path in the forest and enter the cave
    at the end. '
