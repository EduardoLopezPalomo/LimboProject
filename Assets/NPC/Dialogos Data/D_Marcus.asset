  m_Name: D_Marcus
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  NpcName: Marcus
  tipoVoz: 0
  retrato: {fileID: 21300000, guid: 4f24f54b42167ca448c6654f532206e8, type: 3}
  dayGreeting:
  - "Don\u2019t tell anyone, but... the other day I was walking around Naius\u2019
    totem, and..."
  - I felt a terrible stomachache... and had to empty my bowels. Luckily, there was
    no one around.
  nightText: 
  partyText: "The god Naius isn\u2019t angry with me, right? He doesn\u2019t know
    what I did at his altar... right? I\u2019d better leave."
